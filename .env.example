# Informe COUCHDB_URL ou o trio SCHEME/HOST/PORT.
# COUCHDB_URL=http://couchdb.exemplo.interno:5984
COUCHDB_SCHEME=http
COUCHDB_HOST=couchdb.exemplo.interno
COUCHDB_PORT=5984

# Use preferencialmente o usuario tecnico somente leitura.
COUCHDB_USER=bcad_etl
COUCHDB_PASSWORD=troque_esta_senha

COUCH_DB_CNPJ=chcnpj_bcadastros_replica
COUCH_DB_CPF=chcpf_bcadastros_replica
COUCH_DB_SN=chsn_bcadastros_replica

COUCHDB_TIMEOUT=30
COUCHDB_PAGE_LIMIT=1000
COUCHDB_MAX_ATTEMPTS=3
COUCHDB_BACKOFF_FACTOR=0.5
COUCHDB_WORKERS=4
COUCHDB_VERIFY_SSL=true

COUCH_IDX_RESP_DDOC=_design/idx_cpf_responsavel
COUCH_IDX_RESP_NAME=idx-cpf-responsavel
COUCH_CPF_ID_PREFIX=

LOG_LEVEL=INFO
